# ANVIMITRA ERP Backend Environment Configuration

# Server Port
PORT=4000

# PostgreSQL Connection String (Cloud or Local)
# Supports Neon.tech, Supabase, Render, AWS RDS, or Local PostgreSQL
# Example for Neon: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for Supabase: postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres
# Example for Local: postgresql://postgres:password@localhost:5432/anvimitra_erp
DATABASE_URL=

# SQLite Local DB Path (Defaults to data/anvimitra_dev.db)
# DB_PATH=data/anvimitra_dev.db
